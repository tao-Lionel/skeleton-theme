<div class="sn-home full-width" data-sweetnight-home>
  <section class="sn-hero" data-animate style="--hero-image: url({{ 'home-hero.png' | asset_url }});">
    <div class="sn-hero__content">
      <p>New Arrival</p>
      <h1>CoolNest<sup>®</sup> Pro Memory Foam Mattress</h1>
      <span>Stay Cooler, Sleep Deeper</span>
      <a class="sn-button" href="/collections/all">Shop now</a>
    </div>
    <div class="sn-hero__dots" aria-label="Hero slides">
      <button type="button" class="is-active" aria-label="Slide 1"></button>
      <button type="button" aria-label="Slide 2"></button>
    </div>
  </section>

  <section class="sn-benefits" aria-label="Store benefits">
    <div class="sn-benefits__track">
      <span>CoolNest® Temperature-Regulating Comfort</span>
      <span>10-Year Warranty</span>
      <span>Free Shipping & Return</span>
      <span>100-night Risk-free Trial</span>
      <span>CoolNest® Temperature-Regulating Comfort</span>
      <span>10-Year Warranty</span>
      <span>Free Shipping & Return</span>
      <span>100-night Risk-free Trial</span>
    </div>
  </section>

  <section class="sn-awards sn-container" id="awards" data-animate>
    <h2>The USA's Multi-Award-Winning Mattress</h2>
    <img class="sn-awards__badges" src="{{ 'home-awards.png' | asset_url }}" alt="Mattress award badges" loading="lazy">
    <img class="sn-awards__logos" src="{{ 'home-media-logos.png' | asset_url }}" alt="Media logos" loading="lazy">
  </section>

  <section class="sn-categories sn-container" data-animate>
    <h2>Shop By Category</h2>
    <div class="sn-category-grid">
      <a class="sn-category-card" href="/collections/all">
        <span>Mattress</span>
        <img src="{{ 'home-category-mattress.png' | asset_url }}" alt="SweetNight mattress category" loading="lazy">
      </a>
      <a class="sn-category-card" href="/collections/all">
        <span>Pillow</span>
        <img src="{{ 'home-category-pillow.png' | asset_url }}" alt="SweetNight pillow category" loading="lazy">
      </a>
    </div>
  </section>

  <section class="sn-quiz-cta sn-container" data-animate>
    <div>
      <h2>Find Your Perfect SweetNight Mattress</h2>
      <p>Not sure which mattress suits your sleep style? Take our quick quiz to discover the ideal SweetNight mattress for your comfort and needs.</p>
      <button class="sn-button" type="button" data-open-quiz>Find The Right Mattress</button>
    </div>
  </section>

  <section class="sn-products sn-container" data-animate>
    <div class="sn-section-heading">
      <h2>Sleep Better, Starting Tonight</h2>
      <p>Explore our collection of performance mattresses engineered for ultimate pressure relief and support.</p>
    </div>

    <div class="sn-product-grid">
      <article class="sn-product-card">
        <span class="sn-product-card__badge">Free Pillows</span>
        <img src="{{ 'home-product-memory.png' | asset_url }}" alt="CoolNest Memory Foam Mattress" loading="lazy">
        <div class="sn-product-card__body">
          <h3>CoolNest® Memory Foam Mattress</h3>
          <p class="sn-rating">★★★★★ <span>694 Reviews</span></p>
          <h4>Coolnest Comfort</h4>
          <ul>
            <li>CoolNest® System Feels Up to 8° Cooler.</li>
            <li>5-Zone Ergo Support to Relieve Pressure Points.</li>
            <li>Resists Deformation for Long-Lasting Durability.</li>
          </ul>
          <p class="sn-finance">affirm As low as <strong>$33.33/month</strong></p>
          <div class="sn-product-card__footer">
            <span>Starting at <strong>Queen $399.99</strong></span>
            <a class="sn-button" href="/collections/all">Shop Now</a>
          </div>
        </div>
      </article>

      <article class="sn-product-card">
        <span class="sn-product-card__badge">Free Pillows</span>
        <img src="{{ 'home-product-pro.png' | asset_url }}" alt="CoolNest Pro Memory Foam Mattress" loading="lazy">
        <div class="sn-product-card__body">
          <h3>CoolNest® Pro Memory Foam Mattress</h3>
          <p class="sn-rating">★★★★★ <span>35 Reviews</span></p>
          <h4>Coolnest Comfort</h4>
          <ul>
            <li>Advanced Cooling, Cooler All Night.</li>
            <li>7-Zone Precision Support, Full-Body Relief.</li>
            <li>Full-Depth Ventilation, Faster Heat Release.</li>
          </ul>
          <p class="sn-finance">affirm As low as <strong>$44.16/month</strong></p>
          <div class="sn-product-card__footer">
            <span>Starting at <strong>Queen $529.99</strong></span>
            <a class="sn-button" href="/collections/all">Shop Now</a>
          </div>
        </div>
      </article>

      <article class="sn-product-card">
        <span class="sn-product-card__badge">Free Pillows</span>
        <img src="{{ 'home-product-hybrid.png' | asset_url }}" alt="CoolNest Hybrid Mattress" loading="lazy">
        <div class="sn-product-card__body">
          <h3>CoolNest® Hybrid Mattress</h3>
          <p class="sn-rating">★★★★★ <span>102 Reviews</span></p>
          <h4>Coolnest Comfort</h4>
          <ul>
            <li>Promotes airflow for a fresher sleep feel.</li>
            <li>Balanced comfort for Pressure Relief.</li>
            <li>Reinforced Pocket Coils for Lasting Support.</li>
          </ul>
          <p class="sn-finance">affirm As low as <strong>$41.66/month</strong></p>
          <div class="sn-product-card__footer">
            <span>Starting at <strong>Queen $499.99</strong></span>
            <a class="sn-button" href="/collections/all">Shop Now</a>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="sn-pay sn-container" id="financing" data-animate>
    <h2>Upgrade Your Sleep, Pay Your Way</h2>
    <div class="sn-pay__grid">
      <div>
        <strong class="sn-pay__logo sn-pay__logo--affirm">affirm</strong>
        <h3>Sleep Now, Pay Later</h3>
        <p>Financing options as low as 0% APR on mattresses*</p>
      </div>
      <div>
        <strong class="sn-pay__logo">Truemed</strong>
        <h3>FSA/HSA eligible</h3>
        <p>Use your pre-tax HSA/FSA funds to pay for qualifying SweetNight purchases</p>
      </div>
      <div>
        <strong class="sn-pay__logo sn-pay__logo--paypal">PayPal</strong>
        <h3>Zero Credit Required</h3>
        <p>Lease to own. Pay time on your schedule</p>
      </div>
    </div>
    <a class="sn-button" href="/collections/all">Shop Now</a>
  </section>

  <section class="sn-tech sn-container" id="cooling" data-animate>
    <div class="sn-tech__copy">
      <button class="sn-tech__tab is-active" type="button" data-tech-tab="gel">
        <span>Sustained Cool</span>
        Gel-Infused Memory Foam
      </button>
      <button class="sn-tech__tab" type="button" data-tech-tab="airflow">
        <span>Ventilated Cool</span>
        Ventilated Structure
      </button>
      <p data-tech-copy>
        Memory foam infused with 30% gel particles disperses pressure while drawing out heat deep within, ensuring a cool, breathable feel all night long.
      </p>
    </div>
    <div class="sn-tech__media">
      <img class="is-active" data-tech-panel="gel" src="{{ 'home-tech-gel.png' | asset_url }}" alt="Gel infused memory foam close-up" loading="lazy">
      <img data-tech-panel="airflow" src="{{ 'home-tech-airflow.png' | asset_url }}" alt="Ventilated airflow structure" loading="lazy">
    </div>
  </section>

  <button class="sn-coupon" type="button" data-coupon-tab>Get $250 Savings</button>

  <div class="sn-chat" data-chat>
    <button class="sn-chat__close" type="button" data-chat-close aria-label="Close chat">×</button>
    <button class="sn-chat__bubble" type="button" data-chat-toggle>Hi. Need any help?</button>
    <div class="sn-chat__panel" data-chat-panel hidden>
      <strong>SweetNight Support</strong>
      <p>Tell us your sleep position and mattress size. We'll point you to the right model.</p>
      <button class="sn-button" type="button" data-open-quiz>Start quiz</button>
    </div>
  </div>

  <button class="sn-back-top" type="button" data-back-top aria-label="Back to top">↑</button>

  <dialog class="sn-quiz" data-quiz-modal>
    <form method="dialog">
      <button class="sn-quiz__close" value="close" aria-label="Close quiz">×</button>
    </form>
    <div class="sn-quiz__content">
      <p class="sn-quiz__eyebrow">Mattress Finder</p>
      <h2>Find Your Perfect SweetNight Mattress</h2>
      <div class="sn-quiz__progress"><span data-quiz-progress></span></div>
      <div class="sn-quiz__step is-active" data-quiz-step>
        <h3>How do you usually sleep?</h3>
        <button type="button" data-quiz-answer>Side sleeper</button>
        <button type="button" data-quiz-answer>Back sleeper</button>
        <button type="button" data-quiz-answer>Combination</button>
      </div>
      <div class="sn-quiz__step" data-quiz-step>
        <h3>What feel do you prefer?</h3>
        <button type="button" data-quiz-answer>Plush contouring</button>
        <button type="button" data-quiz-answer>Balanced support</button>
        <button type="button" data-quiz-answer>Firm and lifted</button>
      </div>
      <div class="sn-quiz__step" data-quiz-step>
        <h3>Your match</h3>
        <p>CoolNest® Pro Memory Foam Mattress gives you cooler comfort, pressure relief, and stable full-body support.</p>
        <a class="sn-button" href="/collections/all">Shop the match</a>
      </div>
      <div class="sn-quiz__actions">
        <button type="button" data-quiz-prev>Back</button>
        <button type="button" data-quiz-next>Next</button>
      </div>
    </div>
  </dialog>
</div>

{% stylesheet %}
  .sn-home {
    --sn-black: #050505;
    --sn-text: #111;
    --sn-muted: #636363;
    --sn-border: #e8e8e8;
    --sn-soft: #f6f6f6;
    color: var(--sn-text);
    background: #fff;
  }

  .sn-container {
    width: min(calc(100% - 10.8vw), 1620px);
    margin: 0 auto;
  }

  .sn-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 1.65rem;
    border: 0;
    border-radius: 999px;
    background: var(--sn-black);
    color: #fff;
    font-weight: 800;
    text-decoration: none;
    cursor: pointer;
    transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
  }

  .sn-button:hover,
  .sn-button:focus-visible {
    background: #1d1d1d;
    box-shadow: 0 16px 30px rgba(0, 0, 0, 0.18);
    transform: translateY(-2px);
  }

  .sn-hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(570px, 72vw, 840px);
    overflow: hidden;
    background-image:
      linear-gradient(90deg, rgba(0, 0, 0, 0.78) 0%, rgba(0, 0, 0, 0.42) 32%, rgba(0, 0, 0, 0.05) 60%),
      var(--hero-image);
    background-position: center;
    background-size: cover;
  }

  .sn-hero__content {
    position: relative;
    z-index: 1;
    width: min(620px, calc(100% - 10vw));
    margin-left: 5.4vw;
    color: #fff;
  }

  .sn-hero__content p {
    margin-bottom: 0.7rem;
    font-weight: 800;
  }

  .sn-hero__content h1 {
    max-width: 11ch;
    font-size: clamp(2.25rem, 4.1vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: 0;
  }

  .sn-hero__content span {
    display: block;
    margin: 1.2rem 0 2rem;
    font-size: clamp(1.2rem, 1.8vw, 1.8rem);
  }

  .sn-hero__dots {
    position: absolute;
    left: 50%;
    bottom: 2rem;
    display: flex;
    gap: 0.45rem;
    transform: translateX(-50%);
  }

  .sn-hero__dots button {
    width: 1.6rem;
    height: 0.38rem;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.48);
    cursor: pointer;
  }

  .sn-hero__dots .is-active {
    background: #fff;
  }

  .sn-benefits {
    overflow: hidden;
    border-bottom: 1px solid #efefef;
    background: #fff;
  }

  .sn-benefits__track {
    display: flex;
    width: max-content;
    animation: sn-marquee 26s linear infinite;
  }

  .sn-benefits span {
    display: inline-flex;
    align-items: center;
    min-height: 72px;
    padding: 0 3.4rem;
    font-weight: 800;
    white-space: nowrap;
  }

  @keyframes sn-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .sn-awards {
    padding: clamp(4rem, 7vw, 8rem) 0 2.5rem;
    overflow: hidden;
    text-align: center;
  }

  .sn-awards h2,
  .sn-categories h2,
  .sn-quiz-cta h2,
  .sn-pay h2 {
    font-size: clamp(2rem, 3.2vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: 0;
  }

  .sn-awards__badges {
    width: min(1320px, 92vw);
    margin: 3rem auto 4rem;
  }

  .sn-awards__logos {
    width: 100%;
    max-height: 70px;
    object-fit: contain;
    opacity: 0.9;
  }

  .sn-categories {
    padding: 3.2rem 0 5rem;
    text-align: center;
  }

  .sn-category-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: 2.2rem;
  }

  .sn-category-card {
    position: relative;
    display: grid;
    min-height: clamp(340px, 33vw, 580px);
    overflow: hidden;
    border-radius: 8px;
    background: #f6f6f6;
    text-decoration: none;
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  .sn-category-card:hover {
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.09);
    transform: translateY(-4px);
  }

  .sn-category-card span {
    position: absolute;
    top: 2rem;
    left: 50%;
    z-index: 1;
    color: #1a1a1a;
    font-weight: 800;
    transform: translateX(-50%);
  }

  .sn-category-card img {
    align-self: center;
    width: 100%;
    max-height: 86%;
    object-fit: contain;
    transition: transform 260ms ease;
  }

  .sn-category-card:hover img {
    transform: scale(1.035);
  }

  .sn-quiz-cta {
    padding: 3.5rem 0 6rem;
  }

  .sn-quiz-cta > div {
    max-width: 1260px;
    margin: 0 auto;
    padding: clamp(3rem, 5vw, 5rem) 1.5rem;
    border-radius: 8px;
    background: #f4f4f4;
    text-align: center;
  }

  .sn-quiz-cta p {
    max-width: 680px;
    margin: 1rem auto 2rem;
    color: #333;
    line-height: 1.55;
  }

  .sn-products {
    padding: 0 0 clamp(5rem, 8vw, 8rem);
  }

  .sn-section-heading {
    margin-bottom: 2.2rem;
  }

  .sn-section-heading h2 {
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 1.05;
  }

  .sn-section-heading p {
    margin-top: 1rem;
    color: var(--sn-muted);
    font-size: 1.1rem;
  }

  .sn-product-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  .sn-product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 8px;
    background: #f7f7f7;
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  .sn-product-card:hover {
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.1);
    transform: translateY(-5px);
  }

  .sn-product-card__badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 2;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    background: #1d1d1d;
    color: #fff;
    font-size: 0.82rem;
    font-weight: 800;
  }

  .sn-product-card > img {
    width: 100%;
    aspect-ratio: 1 / 0.82;
    object-fit: contain;
    padding: 3.6rem 2rem 1.4rem;
    mix-blend-mode: multiply;
  }

  .sn-product-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 0 2rem 2rem;
  }

  .sn-product-card h3 {
    min-height: 3.4rem;
    font-size: clamp(1.25rem, 1.45vw, 1.55rem);
    line-height: 1.18;
  }

  .sn-rating {
    margin: 1.5rem 0 0.85rem;
    font-weight: 900;
  }

  .sn-rating span {
    margin-left: 0.4rem;
    color: #666;
    font-weight: 500;
  }

  .sn-product-card h4 {
    margin-bottom: 0.6rem;
    font-size: 1rem;
  }

  .sn-product-card ul {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding-left: 1.1rem;
    color: #252525;
    line-height: 1.4;
  }

  .sn-finance {
    margin-top: 1.4rem;
    color: #666;
    font-size: 0.86rem;
  }

  .sn-product-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.5rem;
    border-top: 1px solid #dfdfdf;
  }

  .sn-product-card__footer span {
    color: #333;
    font-size: 0.92rem;
  }

  .sn-product-card__footer strong {
    display: block;
    margin-top: 0.3rem;
    color: #111;
    font-size: 1.2rem;
  }

  .sn-pay {
    padding: clamp(4rem, 8vw, 8rem) 0;
    text-align: center;
  }

  .sn-pay__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    margin: 3rem 0 2rem;
  }

  .sn-pay__grid > div {
    display: grid;
    gap: 0.9rem;
    justify-items: center;
  }

  .sn-pay__logo {
    font-size: 2rem;
  }

  .sn-pay__logo--affirm {
    color: #263bff;
  }

  .sn-pay__logo--paypal {
    color: #0065c8;
    font-style: italic;
  }

  .sn-pay h3 {
    font-size: 1rem;
  }

  .sn-pay p {
    max-width: 420px;
    color: var(--sn-muted);
  }

  .sn-tech {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 6rem);
    padding: 4rem 0 7rem;
  }

  .sn-tech__copy {
    position: sticky;
    top: 150px;
    align-self: start;
    display: grid;
    gap: 1.6rem;
  }

  .sn-tech__tab {
    border: 0;
    background: transparent;
    color: #a7a7a7;
    text-align: left;
    cursor: pointer;
    transition: color 180ms ease, transform 180ms ease;
  }

  .sn-tech__tab span {
    display: block;
    margin-bottom: 0.8rem;
    font-size: 0.9rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .sn-tech__tab {
    font-size: clamp(1.6rem, 2.2vw, 2.5rem);
    font-weight: 800;
    line-height: 1.1;
  }

  .sn-tech__tab.is-active {
    color: #111;
  }

  .sn-tech__tab:hover {
    transform: translateX(4px);
  }

  .sn-tech__copy p {
    max-width: 620px;
    color: var(--sn-muted);
    line-height: 1.55;
  }

  .sn-tech__media {
    display: grid;
    gap: 1rem;
  }

  .sn-tech__media img {
    display: none;
    width: 100%;
    border-radius: 8px;
  }

  .sn-tech__media img.is-active {
    display: block;
    animation: sn-fade 240ms ease;
  }

  @keyframes sn-fade {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .sn-coupon {
    position: fixed;
    right: 0.6rem;
    top: 50%;
    z-index: 60;
    width: 3rem;
    padding: 0.85rem 0.45rem;
    border: 2px solid #1c8bff;
    border-radius: 6px;
    background: #050505;
    color: #fff;
    font-weight: 900;
    line-height: 1.15;
    writing-mode: vertical-rl;
    cursor: pointer;
    transform: translateY(-50%);
  }

  .sn-chat {
    position: fixed;
    right: 1.4rem;
    bottom: 1.4rem;
    z-index: 61;
    display: flex;
    align-items: flex-end;
    gap: 0.7rem;
  }

  .sn-chat__close,
  .sn-quiz__close {
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: 999px;
    background: #fff;
    color: #333;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
    cursor: pointer;
  }

  .sn-chat__bubble {
    min-height: 48px;
    padding: 0 1.2rem;
    border: 0;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
    cursor: pointer;
  }

  .sn-chat__panel {
    position: absolute;
    right: 0;
    bottom: 4.4rem;
    width: min(310px, 82vw);
    padding: 1.2rem;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.18);
  }

  .sn-chat__panel p {
    margin: 0.6rem 0 1rem;
    color: var(--sn-muted);
    line-height: 1.45;
  }

  .sn-back-top {
    position: fixed;
    right: 1.6rem;
    bottom: 6.2rem;
    z-index: 60;
    width: 3rem;
    height: 3rem;
    border: 0;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms ease;
  }

  .sn-back-top.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  .sn-quiz {
    width: min(640px, calc(100% - 2rem));
    border: 0;
    border-radius: 8px;
    padding: 0;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.22);
  }

  .sn-quiz::backdrop {
    background: rgba(0, 0, 0, 0.48);
  }

  .sn-quiz form {
    display: flex;
    justify-content: flex-end;
    padding: 0.8rem;
  }

  .sn-quiz__content {
    padding: 0 2rem 2rem;
  }

  .sn-quiz__eyebrow {
    color: #555;
    font-weight: 800;
    text-transform: uppercase;
  }

  .sn-quiz h2 {
    margin: 0.5rem 0 1.4rem;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.08;
  }

  .sn-quiz__progress {
    height: 0.45rem;
    margin-bottom: 1.5rem;
    border-radius: 999px;
    background: #ececec;
    overflow: hidden;
  }

  .sn-quiz__progress span {
    display: block;
    width: 33.33%;
    height: 100%;
    border-radius: inherit;
    background: #111;
    transition: width 180ms ease;
  }

  .sn-quiz__step {
    display: none;
  }

  .sn-quiz__step.is-active {
    display: grid;
    gap: 0.75rem;
  }

  .sn-quiz__step h3 {
    margin-bottom: 0.35rem;
    font-size: 1.25rem;
  }

  .sn-quiz__step button {
    min-height: 48px;
    border: 1px solid #ddd;
    border-radius: 8px;
    background: #fff;
    cursor: pointer;
  }

  .sn-quiz__step button.is-selected {
    border-color: #111;
    background: #f3f3f3;
    font-weight: 800;
  }

  .sn-quiz__actions {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .sn-quiz__actions button {
    min-height: 44px;
    padding: 0 1.2rem;
    border: 0;
    border-radius: 999px;
    background: #111;
    color: #fff;
    font-weight: 800;
    cursor: pointer;
  }

  .sn-home.is-enhanced [data-animate] {
    opacity: 0;
    transform: translateY(26px);
    transition: opacity 520ms ease, transform 520ms ease;
  }

  .sn-home.is-enhanced [data-animate].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 1180px) {
    .sn-product-grid,
    .sn-pay__grid {
      grid-template-columns: 1fr;
    }

    .sn-product-card {
      max-width: 720px;
      margin: 0 auto;
    }
  }

  @media (max-width: 900px) {
    .sn-container {
      width: min(calc(100% - 2rem), 720px);
    }

    .sn-hero {
      align-items: flex-end;
      min-height: 620px;
      background-position: 58% center;
    }

    .sn-hero__content {
      width: calc(100% - 2rem);
      margin: 0 1rem 4.5rem;
    }

    .sn-category-grid,
    .sn-tech {
      grid-template-columns: 1fr;
    }

    .sn-tech__copy {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .sn-hero__content h1 {
      max-width: 9ch;
    }

    .sn-benefits span {
      min-height: 58px;
      padding: 0 1.6rem;
      font-size: 0.9rem;
    }

    .sn-awards {
      padding-top: 3rem;
    }

    .sn-awards__badges {
      width: 780px;
      max-width: none;
      transform: translateX(-18%);
    }

    .sn-category-card {
      min-height: 360px;
    }

    .sn-product-card__footer {
      align-items: flex-start;
      flex-direction: column;
    }

    .sn-coupon {
      display: none;
    }

    .sn-chat {
      right: 1rem;
      bottom: 1rem;
      max-width: calc(100vw - 2rem);
    }

    .sn-chat__bubble {
      max-width: 13rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const init = (root) => {
      if ('IntersectionObserver' in window) {
        root.classList.add('is-enhanced');

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.16 });

        root.querySelectorAll('[data-animate]').forEach((node) => observer.observe(node));
      }

      root.querySelectorAll('.sn-hero__dots button').forEach((button, index, buttons) => {
        button.addEventListener('click', () => {
          buttons.forEach((item) => item.classList.toggle('is-active', item === button));
          root.querySelector('.sn-hero__content span').textContent = index === 0 ? 'Stay Cooler, Sleep Deeper' : 'Free pillows with each mattress purchase';
        });
      });

      const techCopy = {
        gel: 'Memory foam infused with 30% gel particles disperses pressure while drawing out heat deep within, ensuring a cool, breathable feel all night long.',
        airflow: 'A ventilated structure opens breathable channels through the mattress, moving heat away faster for a fresher sleep surface.'
      };

      root.querySelectorAll('[data-tech-tab]').forEach((tab) => {
        tab.addEventListener('click', () => {
          const key = tab.dataset.techTab;
          root.querySelectorAll('[data-tech-tab]').forEach((item) => item.classList.toggle('is-active', item === tab));
          root.querySelectorAll('[data-tech-panel]').forEach((panel) => panel.classList.toggle('is-active', panel.dataset.techPanel === key));
          root.querySelector('[data-tech-copy]').textContent = techCopy[key];
        });
      });

      const quiz = root.querySelector('[data-quiz-modal]');
      const steps = Array.from(root.querySelectorAll('[data-quiz-step]'));
      const progress = root.querySelector('[data-quiz-progress]');
      let stepIndex = 0;

      const setStep = (nextIndex) => {
        stepIndex = Math.max(0, Math.min(nextIndex, steps.length - 1));
        steps.forEach((step, index) => step.classList.toggle('is-active', index === stepIndex));
        progress.style.width = `${((stepIndex + 1) / steps.length) * 100}%`;
        root.querySelector('[data-quiz-prev]').hidden = stepIndex === 0;
        root.querySelector('[data-quiz-next]').textContent = stepIndex === steps.length - 1 ? 'Done' : 'Next';
      };

      root.querySelectorAll('[data-open-quiz]').forEach((button) => {
        button.addEventListener('click', () => {
          setStep(0);
          if (quiz.showModal) {
            quiz.showModal();
          } else {
            quiz.setAttribute('open', '');
          }
        });
      });

      root.querySelectorAll('[data-quiz-answer]').forEach((answer) => {
        answer.addEventListener('click', () => {
          answer.parentElement.querySelectorAll('[data-quiz-answer]').forEach((item) => item.classList.remove('is-selected'));
          answer.classList.add('is-selected');
        });
      });

      root.querySelector('[data-quiz-prev]').addEventListener('click', () => setStep(stepIndex - 1));
      root.querySelector('[data-quiz-next]').addEventListener('click', () => {
        if (stepIndex === steps.length - 1) {
          if (quiz.close) {
            quiz.close();
          } else {
            quiz.removeAttribute('open');
          }
          return;
        }
        setStep(stepIndex + 1);
      });
      setStep(0);

      const chat = root.querySelector('[data-chat]');
      const panel = root.querySelector('[data-chat-panel]');
      root.querySelector('[data-chat-toggle]').addEventListener('click', () => {
        panel.hidden = !panel.hidden;
      });
      root.querySelector('[data-chat-close]').addEventListener('click', () => {
        chat.hidden = true;
      });

      const coupon = root.querySelector('[data-coupon-tab]');
      coupon.addEventListener('click', () => {
        coupon.textContent = 'Code SLEEP250';
      });

      const backTop = root.querySelector('[data-back-top]');
      backTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      window.addEventListener('scroll', () => {
        backTop.classList.toggle('is-visible', window.scrollY > 800);
      }, { passive: true });
    };

    document.querySelectorAll('[data-sweetnight-home]').forEach(init);
  })();
{% endjavascript %}

