<div class="sn-promo full-width" data-sn-announcement>
  <button class="sn-promo__arrow" type="button" data-announcement-prev aria-label="Previous promotion">‹</button>
  <a class="sn-promo__text" href="/collections/all" data-announcement-text>Father's Day Sale Up To 40% OFF</a>
  <button class="sn-promo__arrow" type="button" data-announcement-next aria-label="Next promotion">›</button>
</div>

<header class="sn-header full-width" data-sn-header>
  <div class="sn-header__inner">
    <button class="sn-header__menu-toggle" type="button" data-mobile-toggle aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
      <span class="visually-hidden">Menu</span>
    </button>

    <a class="sn-header__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      SweetNight<sup>®</sup>
    </a>

    <nav class="sn-header__nav" aria-label="Primary navigation">
      <a href="/collections/all">CoolNest<sup>®</sup></a>
      <details class="sn-header__menu">
        <summary>Mattresses</summary>
        <div class="sn-header__dropdown">
          <a href="/collections/all">Memory Foam Mattresses</a>
          <a href="/collections/all">Hybrid Mattresses</a>
          <a href="/collections/all">Mattress Finder</a>
        </div>
      </details>
      <details class="sn-header__menu">
        <summary>Accessories</summary>
        <div class="sn-header__dropdown">
          <a href="/collections/all">Pillows</a>
          <a href="/collections/all">Protectors</a>
          <a href="/collections/all">Bedding</a>
        </div>
      </details>
      <details class="sn-header__menu">
        <summary>Why SweetNight</summary>
        <div class="sn-header__dropdown">
          <a href="#awards">Awards</a>
          <a href="#cooling">Cooling Tech</a>
          <a href="#financing">Financing</a>
        </div>
      </details>
      <a href="#financing">HSA/FSA Eligible</a>
      <a href="/collections/all">Father's Day Sale</a>
    </nav>

    <div class="sn-header__actions">
      <details class="sn-header__language">
        <summary>English</summary>
        <div class="sn-header__language-menu">
          <a href="{{ routes.root_url }}">English</a>
          <a href="{{ routes.root_url }}">Español</a>
        </div>
      </details>

      <form class="sn-header__search" action="{{ routes.search_url }}" method="get" role="search">
        <input type="search" name="q" placeholder="Search" aria-label="Search">
        <button type="submit" aria-label="Search">Search</button>
      </form>

      {% if shop.customer_accounts_enabled %}
        <shopify-account class="sn-header__icon" menu="{{ section.settings.customer_account_menu }}">
          {{ 'icon-account.svg' | inline_asset_content }}
        </shopify-account>
      {% endif %}

      <a class="sn-header__icon" href="{{ routes.cart_url }}" aria-label="Cart">
        {% if cart.item_count > 0 %}
          <sup>{{ cart.item_count }}</sup>
        {% endif %}
        {{ 'icon-cart.svg' | inline_asset_content }}
      </a>
    </div>
  </div>

  <nav class="sn-header__mobile" data-mobile-panel hidden aria-label="Mobile navigation">
    <a href="/collections/all">CoolNest®</a>
    <a href="/collections/all">Mattresses</a>
    <a href="/collections/all">Accessories</a>
    <a href="#awards">Why SweetNight</a>
    <a href="#financing">HSA/FSA Eligible</a>
    <a href="/collections/all">Father's Day Sale</a>
  </nav>
</header>

{% stylesheet %}
  .visually-hidden {
    position: absolute;
    overflow: hidden;
    width: 1px;
    height: 1px;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .sn-promo {
    position: sticky;
    top: 0;
    z-index: 80;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4rem;
    height: 42px;
    background: #000;
    color: #fff;
    font-size: 0.88rem;
    font-weight: 700;
  }

  .sn-promo__text {
    color: inherit;
    text-decoration: none;
    transition: opacity 180ms ease;
  }

  .sn-promo__text.is-changing {
    opacity: 0;
  }

  .sn-promo__arrow {
    border: 0;
    background: transparent;
    color: #fff;
    font-size: 1.15rem;
    line-height: 1;
    cursor: pointer;
    opacity: 0.85;
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .sn-promo__arrow:hover {
    opacity: 1;
    transform: translateY(-1px);
  }

  .sn-header {
    position: sticky;
    top: 42px;
    z-index: 70;
    border-bottom: 1px solid #e7e2dc;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(14px);
  }

  .sn-header__inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: 68px;
    max-width: 1720px;
    margin: 0 auto;
    padding: 0 5.4vw;
  }

  .sn-header__brand {
    flex: 0 0 auto;
    color: #141414;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.5rem, 1.7vw, 2rem);
    font-style: italic;
    font-weight: 700;
    letter-spacing: 0;
    text-decoration: none;
  }

  .sn-header__brand sup,
  .sn-header__nav sup {
    font-size: 0.45em;
  }

  .sn-header__nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 1.45vw, 1.8rem);
    flex: 1;
    min-width: 0;
  }

  .sn-header__nav a,
  .sn-header__menu summary,
  .sn-header__language summary,
  .sn-header__language a {
    color: #161616;
    font-size: clamp(0.9rem, 0.95vw, 1rem);
    text-decoration: none;
    white-space: nowrap;
  }

  .sn-header__menu,
  .sn-header__language {
    position: relative;
  }

  .sn-header__menu summary,
  .sn-header__language summary {
    display: flex;
    align-items: center;
    gap: 0.32rem;
    list-style: none;
    cursor: pointer;
  }

  .sn-header__menu summary::-webkit-details-marker,
  .sn-header__language summary::-webkit-details-marker {
    display: none;
  }

  .sn-header__menu summary::after,
  .sn-header__language summary::after {
    content: "";
    width: 0.42rem;
    height: 0.42rem;
    border-right: 1px solid currentcolor;
    border-bottom: 1px solid currentcolor;
    transform: rotate(45deg) translateY(-2px);
  }

  .sn-header__dropdown,
  .sn-header__language-menu {
    position: absolute;
    top: calc(100% + 1.2rem);
    left: -1rem;
    display: grid;
    min-width: 220px;
    padding: 0.8rem;
    border: 1px solid #e7e2dc;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.12);
  }

  .sn-header__dropdown {
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px);
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .sn-header__menu[open] .sn-header__dropdown {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .sn-header__dropdown a {
    padding: 0.65rem 0.75rem;
    border-radius: 6px;
  }

  .sn-header__dropdown a:hover {
    background: #f4f4f4;
  }

  .sn-header__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex: 0 0 auto;
  }

  .sn-header__language a {
    padding: 0.35rem 0.5rem;
  }

  .sn-header__search {
    display: flex;
    align-items: center;
    width: 2.35rem;
    height: 2.35rem;
    border: 1px solid transparent;
    border-radius: 999px;
    overflow: hidden;
    transition: width 180ms ease, border-color 180ms ease;
  }

  .sn-header__search:focus-within {
    width: 12rem;
    border-color: #d8d8d8;
  }

  .sn-header__search input {
    min-width: 0;
    width: 100%;
    border: 0;
    outline: 0;
    padding: 0 0.65rem;
    background: transparent;
  }

  .sn-header__search button {
    flex: 0 0 auto;
    width: 2.35rem;
    height: 2.35rem;
    border: 0;
    border-radius: 999px;
    background: #111;
    color: #fff;
    font-size: 0;
    cursor: pointer;
  }

  .sn-header__search button::before {
    content: "⌕";
    font-size: 1.15rem;
  }

  .sn-header__icon {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    min-width: 2rem;
    color: #151515;
    text-decoration: none;
  }

  .sn-header__icon svg {
    width: 1.45rem;
    height: 1.45rem;
  }

  .sn-header__icon sup {
    position: absolute;
    top: -0.25rem;
    right: -0.35rem;
    min-width: 1rem;
    height: 1rem;
    border-radius: 999px;
    background: #111;
    color: #fff;
    font-size: 0.7rem;
    text-align: center;
  }

  .sn-header__menu-toggle {
    display: none;
    width: 2.4rem;
    height: 2.4rem;
    border: 0;
    background: transparent;
    padding: 0.45rem;
  }

  .sn-header__menu-toggle span:not(.visually-hidden) {
    display: block;
    height: 2px;
    margin: 0.28rem 0;
    border-radius: 999px;
    background: #111;
  }

  .sn-header__mobile {
    display: grid;
    gap: 0.1rem;
    padding: 0.6rem 5vw 1rem;
    border-top: 1px solid #eee;
    background: #fff;
  }

  .sn-header__mobile[hidden] {
    display: none;
  }

  .sn-header__mobile a {
    padding: 0.85rem 0;
    color: #111;
    text-decoration: none;
    font-weight: 700;
  }

  @media (max-width: 1080px) {
    .sn-header__inner {
      gap: 1rem;
      padding: 0 4vw;
    }

    .sn-header__nav,
    .sn-header__language {
      display: none;
    }

    .sn-header__menu-toggle {
      display: block;
    }

    .sn-header__brand {
      margin-right: auto;
    }

    .sn-header__search:focus-within {
      width: min(42vw, 12rem);
    }
  }

  @media (max-width: 640px) {
    .sn-promo {
      gap: 1rem;
      height: 38px;
      font-size: 0.78rem;
    }

    .sn-header {
      top: 38px;
    }

    .sn-header__inner {
      min-height: 58px;
    }

    .sn-header__search {
      display: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const messages = [
      "Father's Day Sale Up To 40% OFF",
      "Free Pillows with Each Mattress Purchase",
      "100-night Risk-free Trial"
    ];

    document.querySelectorAll('[data-sn-announcement]').forEach((bar) => {
      const text = bar.querySelector('[data-announcement-text]');
      const prev = bar.querySelector('[data-announcement-prev]');
      const next = bar.querySelector('[data-announcement-next]');
      let index = 0;

      const setMessage = (direction) => {
        index = (index + direction + messages.length) % messages.length;
        text.classList.add('is-changing');
        window.setTimeout(() => {
          text.textContent = messages[index];
          text.classList.remove('is-changing');
        }, 160);
      };

      prev?.addEventListener('click', () => setMessage(-1));
      next?.addEventListener('click', () => setMessage(1));
      window.setInterval(() => setMessage(1), 5000);
    });

    document.querySelectorAll('[data-sn-header]').forEach((header) => {
      const toggle = header.querySelector('[data-mobile-toggle]');
      const panel = header.querySelector('[data-mobile-panel]');

      toggle?.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!expanded));
        panel.hidden = expanded;
      });
    });
  })();
{% endjavascript %}

